PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/tabletap
CLIENT_URL=http://localhost:5173
# Partner emails (nodemailer) — copy to .env and fill real values
# Gmail: use a 16-char APP PASSWORD, NOT your normal Gmail password.
# Google Account → Security → 2-Step Verification ON → App passwords → Mail → Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=you@gmail.com
ADMIN_EMAIL=you@gmail.com
